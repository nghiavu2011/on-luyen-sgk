      "options": [
        "$\\frac{12}{50} = \\frac{6}{25} = 24\\%$",
        "$\\frac{1}{6}$",
        "$\\frac{12}{6} = 2$",
        "$\\frac{50}{12}$"
      ],
      "answer": 0,
      "breakdown": {
        "concept": "Khái niệm xác suất thực nghiệm của một biến cố.",
        "steps": "Xác suất thực nghiệm = (Số lần xuất hiện sự kiện) / (Tổng số lần thử) = 12 / 50 = 24%.",
        "trap": "Nhầm xác suất thực nghiệm với xác suất lý thuyết (1/6) của xúc xắc cân đối."
      }
    }
