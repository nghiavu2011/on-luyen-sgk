    {
      "id": "q04",
      "difficulty": "hard",
      "type": "multiple_choice",
      "question": "Một người nông dân trồng rau trên mảnh đất hình chữ nhật dài 20m, rộng 10m. Biết cứ mỗi mét vuông thu hoạch được 3kg rau. Tổng số kilôgam rau thu được là:",
      "options": [
        "600 kg rau (Diện tích = $20 \\cdot 10 = 200\\text{ m}^2$; Sản lượng = $200 \\cdot 3 = 600\\text{ kg}$)",
        "180 kg rau",
        "300 kg rau",
        "1200 kg rau"
      ],
      "answer": 0,
      "breakdown": {
        "concept": "Toán thực tế tính diện tích và năng suất cây trồng.",
        "steps": "Bước 1: Tính diện tích S = 20 * 10 = 200 m2. Bước 2: Nhân với năng suất: 200 * 3 = 600 kg.",
        "trap": "Lấy chu vi 60m đem nhân 3 ra 180kg (nhầm chu vi với diện tích)."
      }
    },
    {
      "id": "q05",
      "difficulty": "hard",
      "type": "multiple_choice",
      "question": "Cho số nguyên $x$ thỏa mãn: $-3 \\le x < 2$. Tổng tất cả các giá trị nguyên của $x$ là:",
      "options": [
        "$-5$ (các số thỏa mãn là $-3, -2, -1, 0, 1$; tổng $= -3 - 2 - 1 + 0 + 1 = -5$)",
        "$-3$",
        "$0$",
        "$-6$"
      ],
      "answer": 0,
      "breakdown": {
        "concept": "Tìm x trên tập hợp số nguyên Z và tính tổng dãy số nguyên.",
        "steps": "Liệt kê các số nguyên: x ∈ {-3; -2; -1; 0; 1} (chú ý x < 2 nên không lấy số 2). Tính tổng: (-3)+(-2)+(-1)+0+1 = -5.",
        "trap": "Lấy nhầm cả số 2 dẫn đến kết quả sai thành -3."
      }
